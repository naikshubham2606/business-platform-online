# Development environment — Vite dev proxy is active.
# When the proxy is running (npm run dev), leave VITE_API_BASE_URL empty.
# Vite will forward /api/* requests to https://localhost:44350 server-side,
# which eliminates browser CORS restrictions entirely.
#
# For production/staging, set this to the full backend URL:
#   VITE_API_BASE_URL=https://api.yourdomain.com
# and ensure the backend has CORS configured for your frontend origin.
VITE_API_BASE_URL=
